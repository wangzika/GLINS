<launch>
    <arg name="project" default="glins"/>

    <param name="use_sim_time" value="true" />


    <rosparam file="$(find glins)/config/params_HDL_32.yaml" command="load"/>

    <!--- LOAM -->
    <param name="saveDirectory" type="string" value="$(find glins)/data/"/>
    <param name="configDirectory" type="string" value="$(find glins)/config/"/>
    <param name="sequence" type="string" value="MAP"/>
    <include file="$(find glins)/launch/include/module_loam.launch"/>

    <!--- Robot State TF -->
    <include file="$(find glins)/launch/include/module_robot_state_publisher.launch"/>

    <!--- Run Navsat -->
<!--     <node pkg="glins" type="glins_gpsOdometry" name="glins_gpsOdometry"/> -->

    <!--- Run Rviz-->
    <node pkg="rviz" type="rviz" name="$(arg project)_rviz"
          args="-d $(find glins)/launch/include/config/vlp.rviz"/>

</launch>
